<?xml version="1.0" encoding="utf-8"?>
<widget id="cn.zengyuxiang.openshsid" version="0.1.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>openSHSID</name>
    <description>openSHSID —— 问答 / 知识库 / LinkedClassroom</description>
    <author email="zengyuxiang168@gmail.com" href="https://openshsid.zengyuxiang.cn">OpenSHSID</author>
    <content src="index.html" />

    <!-- 原生壳没有 Electron 那种本地反代，网络请求直接打到部署好的公网域名
         （见 frontend/.env.cordova）。access/allow-navigation 只放行这一个域名，
         而不是通配所有来源。 -->
    <access origin="http://openshsid.zengyuxiang.cn:*/*" />
    <access origin="https://openshsid.zengyuxiang.cn:*/*" />
    <allow-navigation href="http://openshsid.zengyuxiang.cn/*" />
    <allow-navigation href="https://openshsid.zengyuxiang.cn/*" />

    <!-- 未被上面白名单覆盖的外链（如分享链接里的第三方网址）交给系统处理，
         而不是让应用内 WebView 卡住/白屏——与 Electron 版 setWindowOpenHandler 的思路一致 -->
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />

    <preference name="DisallowOverscroll" value="true" />
    <preference name="AndroidXEnabled" value="true" />

    <icon src="res/icon/android/xxxhdpi.png" />

    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />
        <preference name="AndroidLaunchMode" value="singleTop" />
        <!-- 仅放行 openshsid.zengyuxiang.cn 的明文 HTTP，见 res/android/network_security_config.xml -->
        <resource-file src="res/android/network_security_config.xml" target="app/src/main/res/xml/network_security_config.xml" />
        <edit-config file="app/src/main/AndroidManifest.xml" target="/manifest/application" mode="merge">
            <application android:networkSecurityConfig="@xml/network_security_config" />
        </edit-config>

        <icon density="ldpi" src="res/icon/android/ldpi.png" />
        <icon density="mdpi" src="res/icon/android/mdpi.png" />
        <icon density="hdpi" src="res/icon/android/hdpi.png" />
        <icon density="xhdpi" src="res/icon/android/xhdpi.png" />
        <icon density="xxhdpi" src="res/icon/android/xxhdpi.png" />
        <icon density="xxxhdpi" src="res/icon/android/xxxhdpi.png" />
    </platform>

    <platform name="ios">
        <preference name="WKWebViewOnly" value="true" />
        <preference name="deployment-target" value="14.0" />
        <!-- 同 Android：只给这一个域名开 ATS 明文例外，而不是关掉整个 ATS -->
        <edit-config target="NSAppTransportSecurity" file="*-Info.plist" mode="merge">
            <dict>
                <key>NSExceptionDomains</key>
                <dict>
                    <key>openshsid.zengyuxiang.cn</key>
                    <dict>
                        <key>NSExceptionAllowsInsecureHTTPLoads</key>
                        <true/>
                        <key>NSIncludesSubdomains</key>
                        <true/>
                    </dict>
                </dict>
            </dict>
        </edit-config>

        <icon src="res/icon/ios/icon-1024.png" width="1024" height="1024" />
    </platform>

    <plugin name="cordova-plugin-whitelist" spec="^1.3.5" />
</widget>
