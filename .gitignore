# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
.eggs/
pip-wheel-metadata/

# Virtual environments
# 含命名版本（如 .venv-verify/）
.venv*/
venv/
env/
.env

# ── 本地临时脚本 ──────────────────────────────────────────────────────────────
# 一次性种子/验证脚本（跑完即删，不入库）
/.seed_*.py
/.verify_*.py

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/

# ── Django ───────────────────────────────────────────────────────────────────
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
/media/
/staticfiles/
/static_collected/
local_settings.py

# Legacy log files
/flask_err.txt
/flask_out.txt

# ── ML model files ───────────────────────────────────────────────────────────
/model/*.pt
/model/*.gguf
# model/data/ 整个目录（local.db、model.pt、log.jsonl 及缓存等运行产物）
/model/data/
# Downloaded OCR model (baidu/Unlimited-OCR) — multi-GB weights + vendored code, not versioned.
# ocr_infer.py / ocr_service.py / requirements-ocr.txt live in /model (not /model/ocr) and stay tracked.
/model/ocr/
# Model weight/binary formats anywhere under model/ (belt-and-suspenders)
/model/**/*.safetensors
/model/**/*.bin
/model/**/*.onnx
/model/**/*.h5
/model/**/*.pt

# ── IDE ──────────────────────────────────────────────────────────────────────
.idea/
.idea/*.iml
.vscode/
*.suo
*.sw?
*.DS_Store

# ── OS junk ──────────────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Python tooling caches ────────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ── Electron desktop app ─────────────────────────────────────────────────────
/electron/node_modules/
/electron/build/
/electron/dist/
/electron/renderer/node_modules/
/electron/renderer/dist/

# ── Tooling ──────────────────────────────────────────────────────────────────
.aider*
.agents/
.claude/

# ── Secrets / environment ────────────────────────────────────────────────────
.env
.env.*
!.env.example
secrets.py
/model/shattered-1.pdf
/model/shattered-2.pdf
# 本地密钥（AI 会话签名），不入库
.env.local
/config.json
